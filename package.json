{
  "name": "sky-guide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "assets:wiki:preflight": "node scripts/assets/cli.mjs preflight",
    "assets:wiki:discover": "node scripts/assets/cli.mjs discover",
    "assets:wiki:download": "node scripts/assets/cli.mjs download",
    "assets:wiki:build": "node scripts/assets/cli.mjs build",
    "assets:wiki:validate": "node scripts/assets/cli.mjs validate",
    "assets:wiki:stats": "node scripts/assets/cli.mjs stats",
    "assets:wiki:clean-raw": "node scripts/assets/cli.mjs clean-raw",
    "dev": "vite",
    "build": "pnpm validate:catalog && pnpm typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/data/*.test.mjs",
    "preview": "vite preview",
    "import:tsa": "node scripts/import-tsa.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "media:wiki:update": "node scripts/import-wiki-media.mjs",
    "media:wiki:validate": "node scripts/validate-wiki-media.mjs",
    "media:wiki:stats": "node scripts/wiki-media-stats.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
