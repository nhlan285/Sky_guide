# Crawler bulk storage: dedicated E: directory only. No C:/TEMP/repo fallback.
SKY_ASSET_ROOT=E:\SkyGuideAssets
SKY_ASSET_CACHE_LIMIT_GB=15
SKY_ASSET_MIN_FREE_GB=20
SKY_ASSET_CONCURRENCY=4
SKY_ASSET_GIT_LIMIT_MB=64
# Later owned storage migration only; no automatic uploads.
# SKY_ASSET_PUBLIC_BASE_URL=https://assets.your-domain.example/items

# Cloudflare R2 private asset storage
# Never commit real credentials. Put them in .env.local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sky-guide-assets
R2_ENDPOINT=